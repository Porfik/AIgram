using "ui/basic.style";
using "ui/widgets/widgets.style";
using "ui/layers/layers.style";
using "chat_helpers/chat_helpers.style";

agentCardTitleLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 100px;
	style: TextStyle(defaultTextStyle) {
		font: font(13px semibold);
	}
}
agentCardTextLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 100px;
}
agentCardDetailLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 100px;
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
agentCardStatusLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 100px;
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(13px italic);
	}
}
agentCardRowSkip: 6px;
agentCardGap: 6px;
agentCardField: InputField(defaultInputField) {
	textMargins: margins(0px, 6px, 0px, 6px);
	heightMin: 32px;
	heightMax: 220px;
}
agentCardTargetItem: PeerListItem(defaultPeerListItem) {
	photoPosition: point(0px, 6px);
	namePosition: point(56px, 11px);
	statusPosition: point(56px, 31px);
}
agentCardSpinner: InfiniteRadialAnimation(defaultInfiniteRadialAnimation) {
	color: windowSubTextFg;
	thickness: 2px;
}
agentCardSpinnerSize: size(14px, 14px);
agentCardCodeLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 100px;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
	palette: TextPalette(defaultTextPalette) {
		monoFg: windowFg;
		selectMonoFg: windowFg;
	}
}
agentCardCodeBg: windowBgOver;
agentCardCodeRadius: 6px;
agentCardCodePadding: margins(8px, 6px, 8px, 6px);
