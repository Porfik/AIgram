using "ui/basic.style";
using "info/info.style";
using "settings/settings.style";

agentPanelEntryButton: IconButton(topBarSearch) {
	icon: icon {{ "menu/ai_prompt", menuIconFg }};
	iconOver: icon {{ "menu/ai_prompt", menuIconFgOver }};
	iconPosition: point(-1px, -1px);
}
agentPanelEntryActive: icon {{ "menu/ai_prompt", windowActiveTextFg }};

agentPanelLayerHeight: 720px;

agentPanelTopBarNew: IconButton(infoTopBarEdit) {
	width: 42px;
	icon: icon {{ "menu/add", boxTitleCloseFg }};
	iconOver: icon {{ "menu/add", boxTitleCloseFgOver }};
	iconPosition: point(9px, -1px);
	rippleAreaPosition: point(0px, 6px);
}
agentPanelTopBarHistory: IconButton(agentPanelTopBarNew) {
	icon: icon {{ "menu/reschedule", boxTitleCloseFg }};
	iconOver: icon {{ "menu/reschedule", boxTitleCloseFgOver }};
}
agentPanelTopBarHistoryActive: icon {{ "menu/reschedule", windowActiveTextFg }};
agentPanelLayerTopBarNew: IconButton(infoLayerTopBarQr) {
	icon: icon {{ "menu/add", boxTitleCloseFg }};
	iconOver: icon {{ "menu/add", boxTitleCloseFgOver }};
}
agentPanelLayerTopBarHistory: IconButton(agentPanelLayerTopBarNew) {
	icon: icon {{ "menu/reschedule", boxTitleCloseFg }};
	iconOver: icon {{ "menu/reschedule", boxTitleCloseFgOver }};
}
agentPanelTopBarMenuDisabled: icon {{ "title_menu_dots", menuFgDisabled }};

agentMemoryEmpty: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowSubTextFg;
	align: align(top);
}
agentMemoryEmptyMargins: margins(22px, 16px, 22px, 4px);
agentMemoryFactMargins: margins(22px, 10px, 92px, 10px);
agentMemoryRowRight: 14px;
agentMemoryFact: FlatLabel(defaultFlatLabel) {
	minWidth: 20px;
}
agentMemoryRowEdit: IconButton {
	width: 32px;
	height: 32px;
	icon: icon {{ "menu/edit", menuIconFg }};
	iconOver: icon {{ "menu/edit", menuIconFgOver }};
}
agentMemoryRowDelete: IconButton(agentMemoryRowEdit) {
	icon: icon {{ "menu/delete", menuIconFg }};
	iconOver: icon {{ "menu/delete", menuIconFgOver }};
}
agentMemoryButtonSkip: 8px;
agentMemoryAddIcon: icon {{ "menu/add", lightButtonFg }};

agentSessionListEmptyHeight: 120px;
agentSessionListRowHeight: 60px;
agentSessionListRowPadding: margins(16px, 12px, 16px, 12px);
agentSessionListTitleStyle: TextStyle(defaultTextStyle) {
	font: font(14px semibold);
}
agentSessionListDateStyle: TextStyle(defaultTextStyle) {
	font: font(12px);
}
