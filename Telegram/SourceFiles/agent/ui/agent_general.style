using "ui/basic.style";
using "ui/layers/layers.style";
using "agent/ui/agent.style";
using "agent/ui/agent_panel.style";
using "settings/settings.style";

agentGeneralContentMaxWidth: 720px;

agentSessionListUserpicSize: 36px;
agentSessionListUserpicGap: 12px;
agentSessionListUserpicShift: 12px;

agentUserpicIcon: icon {{ "menu/ai_prompt", historyPeerUserpicFg }};
agentUserpicIconBase: 42px;

agentHiddenRowUserpicSize: 32px;
agentHiddenRowUserpic: UserpicButton(defaultUserpicButton) {
	size: size(32px, 32px);
	photoSize: 32px;
}
agentHiddenRowShow: IconButton(defaultIconButton) {
	width: 36px;
	height: 36px;
	icon: menuIconRestore;
}
agentHiddenRowHeight: 44px;
agentHiddenRowSkip: 10px;
agentHiddenRowName: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	maxHeight: 20px;
}
agentHiddenRowIcon: icon {{ "menu/chats", menuIconColor }};
agentHiddenAddIcon: icon {{ "menu/add", lightButtonFg }};

agentPaletteWidth: 640px;
agentPaletteTop: 80px;
agentPaletteMargin: 16px;
agentPaletteMinBody: 56px;
agentPaletteHeaderHeight: 52px;
agentPaletteUserpicSize: 32px;
agentPaletteUserpicLeft: 14px;
agentPaletteTitleLeft: 58px;
agentPaletteUserpic: UserpicButton(defaultUserpicButton) {
	size: size(32px, 32px);
	photoSize: 32px;
}
agentPaletteTitle: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
	textFg: windowBoldFg;
	minWidth: 40px;
	maxHeight: 20px;
}
agentPaletteButton: IconButton(boxTitleClose) {
	width: 44px;
	height: 52px;
	rippleAreaPosition: point(4px, 8px);
	rippleAreaSize: 36px;
}
agentPaletteNew: IconButton(agentPaletteButton) {
	icon: icon {{ "menu/add", boxTitleCloseFg }};
	iconOver: icon {{ "menu/add", boxTitleCloseFgOver }};
}
agentPaletteOpen: IconButton(agentPaletteButton) {
	icon: icon {{ "menu/expand", boxTitleCloseFg }};
	iconOver: icon {{ "menu/expand", boxTitleCloseFgOver }};
}
agentPaletteClose: IconButton(agentPaletteButton) {
	icon: icon {{ "box_button_close", boxTitleCloseFg }};
	iconOver: icon {{ "box_button_close", boxTitleCloseFgOver }};
}
agentMenuIconPass: icon {{ "menu/ai_prompt", menuIconColor }};

agentSessionRowsAbout: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	align: align(top);
	minWidth: 100px;
}
agentSessionRowsAboutPadding: margins(16px, 20px, 16px, 20px);

agentProfileCoverSkip: 20px;
agentProfileNameSkip: 10px;
agentProfileUserpic: UserpicButton(defaultUserpicButton) {
	size: size(110px, 110px);
	photoSize: 110px;
}
agentProfileName: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(17px semibold);
	}
	textFg: windowBoldFg;
	align: align(top);
	minWidth: 40px;
	maxHeight: 24px;
}
agentProfileStatus: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	align: align(top);
	minWidth: 40px;
	maxHeight: 20px;
}
agentProfileResetPadding: margins(22px, 8px, 22px, 12px);
agentJournalButton: SettingsButton(settingsButtonNoIcon) {
	height: 40px;
	padding: margins(22px, 8px, 22px, 26px);
}
agentJournalAbout: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	minWidth: 40px;
	maxHeight: 20px;
}
agentJournalAboutTop: 32px;
agentJournalEmptyPadding: margins(22px, 20px, 22px, 12px);

agentModelRowPadding: margins(22px, 9px, 22px, 9px);
agentModelRowSkip: 2px;
agentModelRowCheckSkip: 12px;
agentModelListStatus: FlatLabel(defaultFlatLabel) {
	minWidth: 100px;
	align: align(top);
	textFg: windowSubTextFg;
}
agentModelListStatusPadding: margins(22px, 24px, 22px, 12px);
agentModelChoiceOpenRouterIcon: icon {{ "menu/ai_prompt", menuIconColor }};
agentModelChoiceCustomIcon: icon {{ "menu/ip_address", menuIconColor }};
agentModelChoiceAnthropicIcon: icon {{ "menu/edit_stars", menuIconColor }};
agentModelChoiceSubscriptionIcon: icon {{ "menu/premium", menuIconColor }};
agentModelChoiceKeyIcon: icon {{ "menu/lock", menuIconColor }};
agentClaudeCommandPadding: margins(22px, 12px, 22px, 0px);
