using "ui/basic.style";
using "ui/widgets/widgets.style";
using "chat_helpers/chat_helpers.style";

agentFeedSidePadding: 12px;
agentFeedItemMargin: margins(12px, 8px, 12px, 0px);
agentFeedContentPadding: margins(0px, 8px, 0px, 8px);
agentFeedMaxTextWidth: 440px;

agentFeedUserBubbleBg: windowBgOver;
agentFeedUserRadius: 10px;
agentFeedUserPadding: margins(9px, 6px, 9px, 7px);
agentFeedUserLabel: FlatLabel(defaultFlatLabel) {
	textFg: windowFg;
}

agentFeedDimLabel: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
}
agentFeedTogglePadding: margins(0px, 0px, 0px, 3px);
agentFeedToggleIconSize: size(8px, 8px);
agentFeedToggleIconGap: 5px;
agentFeedToggleIconFg: windowSubTextFg;

agentFeedToolStateFg: windowSubTextFg;
agentFeedToolFailedFg: boxTextFgError;
agentFeedToolExpandPadding: margins(0px, 4px, 0px, 0px);

agentFeedStatusLabel: FlatLabel(defaultFlatLabel) {
	align: align(center);
	textFg: windowSubTextFg;
}
agentFeedWorkingSize: size(14px, 14px);
agentFeedWorkingGap: 6px;
agentFeedWorking: InfiniteRadialAnimation(defaultInfiniteRadialAnimation) {
	color: windowSubTextFg;
}
agentFeedStatusMargin: margins(0px, 12px, 0px, 6px);
agentFeedRetry: RoundButton(defaultActiveButton) {
	textFg: windowActiveTextFg;
	textFgOver: windowActiveTextFg;
	textBg: windowBgOver;
	textBgOver: windowBgRipple;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgRipple;
	}
	width: -12px;
	height: 26px;
	radius: 13px;
	textTop: 4px;
	style: TextStyle(defaultTextStyle) {
		font: font(13px);
	}
}
agentFeedRetryMargin: margins(0px, 8px, 0px, 0px);

agentWelcomeLabel: FlatLabel(defaultFlatLabel) {
	align: align(center);
	textFg: windowSubTextFg;
}
agentOverlayMargin: margins(24px, 0px, 24px, 0px);
agentOverlayGap: 12px;
agentOverlayOpenSettings: RoundButton(agentFeedRetry) {
	width: -16px;
	height: 30px;
	radius: 15px;
	textTop: 5px;
}

agentComposerField: InputField(defaultInputField) {
	textMargins: margins(0px, 8px, 0px, 8px);
	heightMin: 36px;
	heightMax: 224px;
	placeholderFg: windowSubTextFg;
	placeholderFgActive: windowSubTextFg;
	placeholderFgError: windowSubTextFg;
	textFg: windowFg;
	textBg: windowBg;
	border: 0px;
	borderActive: 0px;
}
agentComposerSendIcon: icon {{ "chat/input_send", windowActiveTextFg }};
agentComposerSendIconOver: icon {{ "chat/input_send", windowFgOver }};
agentComposerSend: SendButton {
	sendIconPosition: point(10px, 11px);
	sendIconFillPadding: 0px;
	inner: IconButton(defaultIconButton) {
		width: 36px;
		height: 36px;
		icon: agentComposerSendIcon;
		iconOver: agentComposerSendIconOver;
		rippleAreaSize: 36px;
		rippleAreaPosition: point(0px, 0px);
	}
	stars: RoundButton(defaultActiveButton) {
		height: 28px;
		padding: margins(0px, 0px, 6px, 0px);
		textTop: 5px;
		width: -8px;
	}
	recordSize: size(24px, 24px);
	sendDisabledFg: windowSubTextFg;
	sendIconFg: windowActiveTextFg;
	stopSize: size(12px, 12px);
	stopRadius: 3px;
}
agentComposerPadding: margins(12px, 8px, 12px, 10px);
agentComposerRowGap: 8px;
agentQueuedLabel: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
agentQueuedBubbleBg: windowBgOver;
agentQueuedBubbleRadius: 8px;
agentQueuedBubblePadding: margins(8px, 5px, 8px, 6px);
agentQueuedBubbleMargin: margins(0px, 4px, 0px, 0px);
agentQueuedBottomGap: 6px;