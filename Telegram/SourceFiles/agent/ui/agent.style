using "ui/basic.style";
using "ui/widgets/widgets.style";
using "chat_helpers/chat_helpers.style";

agentFeedItemMargin: margins(16px, 6px, 16px, 6px);
agentFeedUserMargin: margins(48px, 10px, 16px, 6px);
agentFeedContentPadding: margins(0px, 10px, 0px, 10px);
agentFeedMaxTextWidth: 440px;
agentFeedBottomSkip: 12px;

agentFeedUserBubbleBg: windowBgOver;
agentFeedUserRadius: 12px;
agentFeedUserPadding: margins(11px, 7px, 11px, 8px);
agentFeedUserLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowFg;
}
agentFeedTextLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowFg;
}

agentStepsHeaderHeight: 28px;
agentStepsRowHeight: 26px;
agentStepsLineFg: windowBgOver;
agentStepsLineSkip: 2px;
agentStepsHeaderFg: windowSubTextFg;
agentStepsHeaderFgOver: windowFg;
agentStepsFailedFg: boxTextFgError;
agentStepsChevronSize: 8px;
agentStepsChevronStroke: 1.5;
agentStepsTitleLeft: 18px;
agentStepsListMargin: margins(10px, 0px, 0px, 2px);
agentStepsRowMargin: margins(8px, 0px, 0px, 0px);
agentStepsDetailsMargin: margins(18px, 2px, 0px, 8px);
agentStepsDetailsGap: 6px;
agentStepsSpinner: InfiniteRadialAnimation(defaultInfiniteRadialAnimation) {
	color: windowSubTextFg;
	thickness: 2px;
}
agentStepsSpinnerSize: size(12px, 12px);
agentStepsSectionLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
agentStepsThinkingLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowSubTextFg;
}
agentStepsCodeLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
	palette: TextPalette(defaultTextPalette) {
		monoFg: windowFg;
		selectMonoFg: windowFg;
	}
}
agentStepsCodeBg: windowBgOver;
agentStepsCodeRadius: 6px;
agentStepsCodePadding: margins(8px, 6px, 8px, 6px);

agentFeedSummaryLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	align: align(center);
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}

agentFeedStatusLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	align: align(center);
	textFg: windowSubTextFg;
}
agentFeedStatusPadding: margins(16px, 8px, 16px, 8px);
agentFeedWorkingSize: size(14px, 14px);
agentFeedWorkingGap: 6px;
agentFeedWorking: InfiniteRadialAnimation(defaultInfiniteRadialAnimation) {
	color: windowSubTextFg;
	thickness: 2px;
}
agentFeedRetry: RoundButton(defaultActiveButton) {
	textFg: windowActiveTextFg;
	textFgOver: windowActiveTextFg;
	textBg: windowBgOver;
	textBgOver: windowBgRipple;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgRipple;
	}
	width: -12px;
	height: 26px;
	radius: 13px;
	textTop: 4px;
	style: TextStyle(defaultTextStyle) {
		font: font(13px);
	}
}
agentFeedRetryMargin: margins(0px, 8px, 0px, 0px);

agentWelcomeLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	align: align(center);
	textFg: windowSubTextFg;
}
agentOverlayMargin: margins(24px, 0px, 24px, 0px);
agentOverlayGap: 12px;
agentOverlayOpenSettings: RoundButton(agentFeedRetry) {
	width: -16px;
	height: 30px;
	radius: 15px;
	textTop: 5px;
}

agentComposerFieldLeft: 14px;
agentComposerQueuedPadding: margins(14px, 8px, 10px, 2px);
agentQueuedLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
agentQueuedTextLabel: FlatLabel(agentQueuedLabel) {
	textFg: windowFg;
}
agentQueuedBubbleBg: windowBgOver;
agentQueuedBubbleRadius: 8px;
agentQueuedBubblePadding: margins(8px, 5px, 8px, 6px);
agentQueuedLabelMargin: margins(0px, 0px, 0px, 2px);
agentQueuedBubbleMargin: margins(40px, 4px, 0px, 0px);

agentFeedCardBg: windowBgOver;
agentFeedCardRadius: 12px;
agentFeedCardPadding: margins(12px, 10px, 12px, 12px);
agentFeedCardTitleLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowFg;
	style: TextStyle(defaultTextStyle) {
		font: font(13px semibold);
	}
}
agentFeedCardTargetLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowFg;
}
agentFeedCardDetailLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
agentFeedCardStatusLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowSubTextFg;
}
agentFeedCardGap: 6px;
agentFeedCardField: InputField(historyComposeField) {
	textMargins: margins(8px, 7px, 8px, 7px);
	heightMax: 220px;
	textBg: windowBgRipple;
	textBgActive: windowBgRipple;
	textFg: windowFg;
	placeholderFg: windowSubTextFg;
	placeholderFgActive: windowSubTextFg;
	placeholderFgError: windowSubTextFg;
}
agentFeedCardCheckbox: Checkbox(defaultCheckbox) {
	textFg: windowFg;
	style: TextStyle(defaultTextStyle) {
		font: font(13px);
	}
}
agentFeedCardButton: RoundButton(defaultLightButton) {
	height: 30px;
	radius: 15px;
	textTop: 6px;
	textFg: windowFg;
	textFgOver: windowFg;
	textBg: windowBgRipple;
	textBgOver: windowBgOver;
	width: -24px;
}
agentFeedCardButtonMain: RoundButton(defaultActiveButton) {
	height: 30px;
	radius: 15px;
	textTop: 6px;
	width: -24px;
}
agentFeedCardButtonDanger: RoundButton(agentFeedCardButton) {
	textFg: boxTextFgError;
	textFgOver: boxTextFgError;
}
agentFeedCardButtonMargin: margins(0px, 12px, 0px, 0px);
agentFeedCardButtonsGap: 8px;
agentFeedCardSpinner: InfiniteRadialAnimation(defaultInfiniteRadialAnimation) {
	color: windowSubTextFg;
	thickness: 2px;
}
agentFeedCardSpinnerSize: size(14px, 14px);
agentFeedActionsMarkGood: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: menuIconFgOver;
	style: TextStyle(defaultTextStyle) {
		font: font(13px semibold);
	}
}
agentFeedActionsMarkBad: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: boxTextFgError;
	style: TextStyle(defaultTextStyle) {
		font: font(13px semibold);
	}
}
agentFeedActionsUndoLink: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowActiveTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(13px);
	}
	palette: TextPalette(defaultTextPalette) {
		linkFg: windowActiveTextFg;
	}
}
agentFeedActionsRowGap: 6px;
agentFeedActionsUndoAllMargin: margins(0px, 8px, 0px, 0px);

agentSessionListDeleteIcon: icon {{ "menu/delete", menuIconFg }};
agentSessionListDeleteRight: 14px;
agentSessionListDeleteTextGap: 8px;

agentFeedSpendingLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 40px;
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
agentFeedSpendingMargin: margins(16px, 4px, 16px, 6px);
